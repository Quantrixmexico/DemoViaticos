{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demoviaticos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Las variables de ejecución se administran en el panel de Cloudflare
  // (Settings → Variables and Secrets). Sin esto, cada despliegue con wrangler
  // borra las que no estén declaradas en este archivo.
  "keep_vars": true,
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "demoviaticos"
    }
  ]
}
